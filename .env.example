# Copy to .env.local for local development, and set the same values in
# Vercel → Settings → Environment Variables for the deployment.
#
# .env.local is gitignored. Never commit real values, and never rename any of
# these to NEXT_PUBLIC_* — that prefix inlines the value into the browser
# bundle, which for the service_role key would hand every visitor full
# read/write access to the database.

# --- Required ---------------------------------------------------------------

# Supabase → Project Settings → Data API → Project URL.
# Same project as the Peshagi site; this app just writes to its own two tables.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → service_role (labelled "secret" in
# the newer key UI). This key bypasses RLS, which is the whole point: the
# tables have RLS on with no anon policies, so this route handler is the only
# way in. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional ---------------------------------------------------------------

# Cloudflare Turnstile secret. Unset, the check is skipped entirely; set, every
# submission must carry a valid token — which also means the forms have to
# start sending one, so don't set this before wiring the widget in.
TURNSTILE_SECRET_KEY=

# Comma-separated hosts allowed to post, e.g. pervyukt.com,www.pervyukt.com.
# Unset means same-origin only, which already covers production and Vercel
# preview URLs because the forms post to a relative /api/submit. Only needed if
# the page is ever served from a different host than the API.
ALLOWED_ORIGINS=

# Resend → API Keys. "Sending access" permission is enough. Unset, the
# notification is skipped entirely and submissions still save — the row is the
# record of truth, the email is a courtesy on top.
RESEND_API_KEY=

# Sender. Must be an address on a domain verified at resend.com/domains once
# alerts go to anyone other than the Resend account owner. Until then use
# "Pervyukt <onboarding@resend.dev>", which needs no DNS but can ONLY deliver to
# that owner's own address — anything else comes back 403 validation_error.
# NEVER put the visitor's address here; that is spoofing and fails DMARC. The
# visitor goes in reply_to, which the route handler sets automatically.
NOTIFY_FROM=

# Where alerts land. Comma-separated for more than one recipient — note each
# recipient counts separately against Resend's 100/day free quota.
NOTIFY_TO=
